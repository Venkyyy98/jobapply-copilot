{
  "manifest_version": 3,
  "name": "JobApply Copilot",
  "description": "Ethical application copilot: analyze jobs, tailor docs, and assist safe prefill.",
  "version": "0.1.3",
  "permissions": ["activeTab", "scripting", "storage", "downloads", "sidePanel", "tabs"],
  "host_permissions": [
    "https://jobapply-copilot-api.onrender.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "JobApply Copilot"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
