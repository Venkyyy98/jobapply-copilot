OPENAI_API_KEY=your_openai_api_key_here
# Optional for hosted beta. Users can also provide their own OpenAI key per request from the web/extension UI.
JAC_TOKEN=replace_with_random_shared_token
SERPAPI_KEY=your_serpapi_key_here
HUNTER_API_KEY=your_hunter_api_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
NEXTAUTH_SECRET=replace_with_random_long_secret
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
NEXT_PUBLIC_CHROME_EXTENSION_URL=
JAC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JAC_ANALYZE_DAILY_QUOTA=25
JAC_DOCS_DAILY_QUOTA=10
JAC_OUTREACH_DAILY_QUOTA=20
JAC_GENERATED_FILE_RETENTION_HOURS=72
JAC_LINKEDIN_DISCOVERY_ENABLED=false
JAC_ALLOW_SERVER_LLM_FALLBACK=false
JAC_DB_PATH=./jobapply.db
JAC_OUTPUT_DIR=./outputs
JAC_PACKET_DIR=~/Documents/JobApplyCopilot
JAC_CANDIDATE_PROFILE=./server/data/candidate_profile.yaml
JAC_PREFERENCES=./server/data/preferences.yaml
